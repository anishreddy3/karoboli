# Required for the live voice path
SARVAM_API_KEY=
SARVAM_AGENT_API_KEY=

# Verified public Sarvam APIs
SARVAM_API_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_TTS_MODEL=bulbul:v3

# Documented Samvaad runtime values. The app ID must have a committed version.
SARVAM_AGENT_ORG_ID=
SARVAM_AGENT_WORKSPACE_ID=
SARVAM_AGENT_APP_ID=
SARVAM_AGENT_VERSION=
SARVAM_AGENT_RUNTIME_BASE_URL=https://apps.sarvam.ai/api/app-runtime/
SARVAM_AGENT_BUYER_STATE=
SARVAM_AGENT_SUPPLIER_STATE=

# Browser → Karoboli gateway. Use a long random shared secret on both services.
SAMVAAD_GATEWAY_URL=
SAMVAAD_GATEWAY_SHARED_SECRET=
SAMVAAD_ALLOWED_ORIGINS=http://localhost:3000

# Gateway/Samvaad tools → deterministic Karoboli APIs.
KAROBOLI_TOOL_BASE_URL=http://localhost:3000
AGENT_TOOL_SHARED_SECRET=

# Optional separately provisioned supporting apps.
SARVAM_CONTENT_AGENT_APP_ID=
SARVAM_DOC_AGENT_APP_ID=

# Milestone 4 — Telephony
# Provisioned Sarvam telephony connection and agent number.
SARVAM_TELEPHONY_CONNECTION_ID=
SARVAM_TELEPHONY_AGENT_NUMBER=
# Optional HMAC-SHA256 secret to verify inbound webhook events from Sarvam.
SARVAM_TELEPHONY_WEBHOOK_SECRET=
